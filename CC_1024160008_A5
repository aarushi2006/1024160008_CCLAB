        "\n",
        "\n",
        "print(\"Median:\", np.median(ucs420_yashit_arora))\n",
        "\n",
        "\n",
        "print(\"Maximum:\", np.max(ucs420_yashit_arora))\n",
        "\n",
        "\n",
        "print(\"Minimum:\", np.min(ucs420_yashit_arora))\n",
        "\n",
        "\n",
        "print(\"Shape:\", ucs420_yashit_arora.shape)\n",
        "\n",
        "\n",
        "reshaped_ucs420_yashit_arora = ucs420_yashit_arora.reshape(4,3)\n",
        "\n",
        "print(\"\\nReshaped Array (4x3):\")\n",
        "print(reshaped_ucs420_yashit_arora)\n",
