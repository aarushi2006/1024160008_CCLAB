      "source": [
        "Q2(b)(i). Find Most Frequent Value and Indices"
      ],
      "metadata": {
        "id": "cM5yKCX6A99v"
      }
    },
    {
      "cell_type": "code",
      "source": [
        "import numpy as np\n",
        "\n",
        "arr = np.array([1, 2, 3, 4, 5, 1, 2, 1, 1, 1])\n",
        "\n",
        "\n",
        "values, counts = np.unique(arr, return_counts=True)\n",
        "\n",
        "\n",
        "most_freq = values[np.argmax(counts)]\n",
        "\n",
        "\n",
        "indices = np.where(arr == most_freq)[0]\n",
        "\n",
        "print(\"Most Frequent Value:\", most_freq)\n",
        "print(\"Indices:\", indices)"
      ],
